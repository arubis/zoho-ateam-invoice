#!/usr/bin/env python3
"""
Zoho Books Invoice Pipeline

Usage:
  zoho-ateam-invoice <invoice.pdf>
  zoho-ateam-invoice --csv <timesheet.csv> <invoice.pdf>
  zoho-ateam-invoice --list

Reads invoice PDFs (and optionally timesheet CSVs), creates matching invoices
in Zoho Books, marks them as sent (no email), records payment.

Idempotent: checks for existing invoice by number before creating.

Required environment variables (or .env file — see load_env()):
  ZOHO_CLIENT_ID
  ZOHO_CLIENT_SECRET
  ZOHO_REFRESH_TOKEN
  ZOHO_ORG_ID
  ZOHO_CUSTOMER_ID
  ZOHO_BANK_ACCOUNT_ID
  ZOHO_INVOICE_PREFIX     (e.g. "INV", default: "INV")
  ZOHO_RATE               (hourly rate, default: 90)

Credential lookup order:
  1. Environment variables
  2. ZOHO_ENV_FILE path
  3. ~/.env
  4. ~/.openclaw/.env

Data discrepancy rules:
  CSV vs PDF   — if CSV hours × rate ≠ PDF total, warn and use the PDF (= what was paid).
  PDF internal — if hours × rate ≠ PDF total, refuse. Booking a total that disagrees
                 with its own line item is a bookkeeping error, not something to guess at.
"""

import csv, subprocess, re, os, sys, json, argparse
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

TOKEN_URL = "https://accounts.zoho.com/oauth/v2/token"
API_BASE = "https://www.zohoapis.com/books/v3"

ZOHO_KEYS = (
    "ZOHO_CLIENT_ID",
    "ZOHO_CLIENT_SECRET",
    "ZOHO_REFRESH_TOKEN",
    "ZOHO_ORG_ID",
    "ZOHO_CUSTOMER_ID",
    "ZOHO_BANK_ACCOUNT_ID",
)

# Optional, with defaults applied at the call site.
ZOHO_OPTIONAL_KEYS = ("ZOHO_INVOICE_PREFIX", "ZOHO_RATE")

_DEFAULT_ENV_PATHS = [
    "~/.env",
    "~/.openclaw/.env",
]


class InvoiceError(Exception):
    """A failure affecting one invoice. In batch mode the run continues."""


class NotAnInvoice(InvoiceError):
    """
    A PDF with none of the expected markers — a bank statement that happens to
    share a download folder, not a broken export. Walking a directory ignores
    these; naming one explicitly is still an error.
    """


def load_env(env_file=None):
    """
    Load credentials using standard precedence:
      1. Environment variables
      2. .env file — checked in order:
           a. env_file argument
           b. ZOHO_ENV_FILE environment variable
           c. ~/.env
           d. ~/.openclaw/.env  (OpenClaw default)
    Returns a merged dict; env vars take precedence over file values.
    """
    result = {k: os.environ[k] for k in ZOHO_KEYS + ZOHO_OPTIONAL_KEYS if k in os.environ}

    if all(k in result for k in ZOHO_KEYS):
        return result

    candidates = []
    if env_file:
        candidates.append(env_file)
    if os.environ.get("ZOHO_ENV_FILE"):
        candidates.append(os.environ["ZOHO_ENV_FILE"])
    candidates += [os.path.expanduser(p) for p in _DEFAULT_ENV_PATHS]

    # Merge every candidate file, earliest wins. Stopping at the first file that
    # merely *exists* means an unrelated ~/.env shadows ~/.openclaw/.env entirely.
    file_env = {}
    for path in candidates:
        if not os.path.exists(path):
            continue
        with open(path) as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    file_env.setdefault(k.strip(), v.strip().strip("\"'"))

    return {**file_env, **result}


def require_env(env, *keys):
    missing = [k for k in keys if not env.get(k)]
    if missing:
        print(f"Missing required config: {', '.join(missing)}", file=sys.stderr)
        print("Set as environment variables or in a .env file. See .env.example.", file=sys.stderr)
        sys.exit(1)


def request_json(url, method="GET", data=None, headers=None):
    """
    Return the decoded JSON body. Zoho signals failure in the body with a non-zero
    `code`, often alongside a 4xx status, so error responses are parsed rather than
    raised — callers inspect `code` themselves.
    """
    req = Request(url, data=data, headers=headers or {}, method=method)
    try:
        with urlopen(req) as resp:
            body = resp.read()
    except HTTPError as e:
        body = e.read()
    except URLError as e:
        print(f"Network error calling {url}: {e.reason}", file=sys.stderr)
        sys.exit(1)
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        print(f"Non-JSON response from {url}: {body[:200]!r}", file=sys.stderr)
        sys.exit(1)


def get_access_token(env):
    # Credentials go in the request body, never in argv — process arguments are
    # world-readable via `ps` for the life of the call.
    body = urlencode({
        "refresh_token": env["ZOHO_REFRESH_TOKEN"],
        "client_id": env["ZOHO_CLIENT_ID"],
        "client_secret": env["ZOHO_CLIENT_SECRET"],
        "grant_type": "refresh_token",
    }).encode()
    resp = request_json(TOKEN_URL, "POST", body,
                        {"Content-Type": "application/x-www-form-urlencoded"})
    if "access_token" not in resp:
        print(f"Token refresh failed: {resp}", file=sys.stderr)
        sys.exit(1)
    return resp["access_token"]


def api(method, path, token, org_id, data=None, extra_params=""):
    url = f"{API_BASE}{path}?organization_id={org_id}{extra_params}"
    return request_json(
        url, method,
        json.dumps(data).encode() if data else None,
        {"Authorization": f"Zoho-oauthtoken {token}",
         "Content-Type": "application/json"},
    )


def find_invoice_by_number(token, org_id, invoice_number):
    resp = api("GET", "/invoices", token, org_id, extra_params=f"&invoice_number={invoice_number}")
    # Zoho's invoice_number filter matches substrings — INV-812 also returns
    # INV-81212. On an idempotency guard a false positive silently skips a real
    # invoice, so match exactly.
    for inv in resp.get("invoices", []):
        if inv.get("invoice_number") == invoice_number:
            return inv
    return None


def uncategorized_deposit_dates(token, org_id, bank_account_id):
    """
    {amount: date} for deposits sitting unmatched on the bank account.

    /banktransactions omits uncategorized rows unless asked for them by name,
    so the default listing hides money that has landed but has not yet been
    matched to an invoice. Recording a payment on the date it actually arrived
    (rather than the invoice's issue date, 2-11 days earlier) is what lets
    Zoho auto-suggest the match in the Banking screen.

    An amount claimed by more than one deposit is dropped rather than guessed
    at, the same way ambiguous CSV pairings are.
    """
    seen = {}
    page = 1
    while True:
        resp = api("GET", "/banktransactions", token, org_id,
                   extra_params=f"&account_id={bank_account_id}&per_page=200"
                                f"&page={page}&filter_by=Status.Uncategorized")
        rows = resp.get("banktransactions", [])
        for t in rows:
            seen.setdefault(round(float(t.get("amount", 0)), 2), []).append(t.get("date"))
        if not resp.get("page_context", {}).get("has_more_page") or not rows:
            break
        page += 1
    return {amt: dates[0] for amt, dates in seen.items() if len(dates) == 1}


def list_invoices(token, org_id, customer_id):
    resp = api("GET", "/invoices", token, org_id,
               extra_params=f"&customer_id={customer_id}&per_page=200")
    invoices = resp.get("invoices", [])
    invoices.sort(key=lambda i: i.get("invoice_number", ""))

    status_icon = {"paid": "✓", "sent": "→", "draft": "·", "overdue": "!"}
    print(f"{'Invoice #':<20} {'Date':<12} {'Total':>10}  {'Status'}")
    print("─" * 55)
    for inv in invoices:
        status = inv.get("status", "")
        icon = status_icon.get(status, " ")
        print(f"{inv['invoice_number']:<20} {inv['date']:<12} ${float(inv['total']):>9,.2f}  {icon} {status}")


def format_hours(hours):
    """
    Render hours the way the export writes them: 108.91666... -> "108h 55m".
    A bare decimal is accurate but harder to check against the source PDF.
    """
    whole = int(hours)
    minutes = round((hours - whole) * 60)
    if minutes == 60:          # 79.9999 from float division must not become "79h 60m"
        whole, minutes = whole + 1, 0
    return f"{whole}h {minutes}m" if minutes else f"{whole}h"


def extract_period(text):
    """
    The billing period, which ends up in the invoice line description.

    In the real exports "SUMMARY FOR PERIOD" is a *column header* and the value
    sits on the next line ("01/01-01/15/2026"), with "FROM ... TO" heading the
    address columns to its right. Taking the rest of the header line puts the
    literal text "FROM  TO" on the invoice, so fall through to the next line
    whenever the same-line remainder is empty or is itself a header.
    """
    m = re.search(r"SUMMARY FOR PERIOD[ \t]*(.*)\n\s*(\S+)", text)
    if not m:
        return ""
    same_line = m.group(1).strip()
    if same_line and not re.match(r"FROM\b", same_line):
        return same_line
    return m.group(2).strip()


def parse_invoice_pdf(path):
    r = subprocess.run(["pdftotext", "-layout", path, "-"], capture_output=True, text=True)
    if r.returncode != 0:
        raise InvoiceError(f"pdftotext failed: {r.stderr.strip()}")
    text = r.stdout

    stmt = re.search(r"Earnings Statement #(\d+)", text)
    date = re.search(r"Date of issue:\s+([\d/]+)", text)
    # Hours are "79h 30m", not a decimal. Matching only the "79h" silently drops
    # the minutes: 79 × $90 = $7,110 against a stated total of $7,155, which is
    # how INV-82924 came to be created wrong and voided.
    hours = re.search(r"TOTAL HOURS\s+(\d+)h(?:\s*(\d+)m)?", text)
    rate = re.search(r"HOURLY RATE\s+\$(\d+)", text)
    total = re.search(r"TOTAL PAYMENT\s+\$([\d,]+(?:\.\d+)?)", text)
    period = extract_period(text)

    if not any([stmt, date, total]):
        # Not one marker matched — this isn't an earnings statement at all.
        raise NotAnInvoice("not an invoice PDF")
    if not all([stmt, date, total]):
        # Some markers matched, so it looks like an export we failed to read.
        found = ", ".join(f"{k}={'yes' if v else 'no'}" for k, v in
                          (("statement#", stmt), ("date", date), ("total", total)))
        raise InvoiceError(f"could not parse required fields from PDF ({found})")

    return {
        "stmt_number": stmt.group(1),
        "date_us": date.group(1),
        "hours": int(hours.group(1)) + int(hours.group(2) or 0) / 60 if hours else None,
        "rate": int(rate.group(1)) if rate else None,
        "total": float(total.group(1).replace(",", "")),
        "period": period,
    }


def parse_csv_hours(path):
    total = 0.0
    with open(path, newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            # DictReader fills short rows with None rather than omitting the key,
            # so the default on .get() never fires — real exports have such rows.
            h = (row.get("Hours") or "0").strip()
            if ":" in h:
                parts = h.split(":")
                try:
                    total += int(parts[0]) + int(parts[1]) / 60
                except ValueError:
                    pass
            else:
                try:
                    total += float(h)
                except ValueError:
                    pass
    return total


# Billing period as it appears in export filenames. Three formats in the wild:
#   "A.Team Invoice - 2026 Jan. 01-15 (82231).pdf"        → Jan. 01-15
#   "Dylan Fitzgerald's Timesheet - Jan 1 - Jan 15.csv"   → Jan 1 - Jan 15
#   "A.Team_Invoice_-_2026_Mar._01-15_85565---<uuid>.pdf" → Mar._01-15
# The third is how OpenClaw stores attachments in ~/.openclaw/media/inbound:
# spaces become underscores, so underscores count as separators too.
_PERIOD_RE = re.compile(
    r"([A-Za-z]{3})[a-z]*\.?[\s_]+(\d{1,2})[\s_]*[-–—][\s_]*"
    r"(?:[A-Za-z]{3}[a-z]*\.?[\s_]+)?(\d{1,2})"
)


def period_key(filename):
    """
    (month, start_day, end_day) for a filename, or None if no period is found.
    The year is deliberately ignored — timesheet exports don't carry one, which
    is why pair_csvs() has to treat repeated month ranges as ambiguous.
    """
    m = _PERIOD_RE.search(os.path.basename(filename))
    if not m:
        return None
    return (m.group(1).lower(), int(m.group(2)), int(m.group(3)))


def pair_csvs(pdf_paths, csv_paths):
    """
    Map each PDF to a timesheet CSV covering the same billing period.

    Returns (pairs, ambiguous). A period claimed by more than one PDF or more
    than one CSV is left unpaired and reported: without a year in the CSV name,
    "Dec 16 - Dec 31" cannot be attributed to 2025 over 2026, and quietly
    cross-checking against the wrong timesheet is worse than not checking.
    """
    pdfs_by_period, csvs_by_period = {}, {}
    for path in pdf_paths:
        pdfs_by_period.setdefault(period_key(path), []).append(path)
    for path in csv_paths:
        csvs_by_period.setdefault(period_key(path), []).append(path)

    pairs, ambiguous = {}, []
    for period, pdfs in pdfs_by_period.items():
        csvs = csvs_by_period.get(period, [])
        if period is None or not csvs:
            continue
        if len(pdfs) > 1 or len(csvs) > 1:
            ambiguous += pdfs
            continue
        pairs[pdfs[0]] = csvs[0]
    return pairs, ambiguous


def collect_pdfs(paths):
    """Expand any directory argument into the PDFs directly inside it."""
    out = []
    for path in paths:
        if os.path.isdir(path):
            out += sorted(os.path.join(path, n) for n in os.listdir(path)
                          if n.lower().endswith(".pdf"))
        else:
            out.append(path)
    return out


def parse_date(us_date):
    m, d, y = us_date.split("/")
    return f"{y}-{m.zfill(2)}-{d.zfill(2)}"


def create_invoice(token, org_id, customer_id, inv_number, date_iso, hours, rate, total, period):
    # The invoice total is whatever Zoho computes from rate × quantity. If that
    # disagrees with the PDF, the payment recorded below would not match the
    # invoice raised — refuse rather than book two different numbers.
    computed = round(hours * rate, 2)
    if abs(computed - total) > 0.01:
        raise InvoiceError(
            f"{format_hours(hours)} × ${rate}/hr = ${computed:,.2f}, but the PDF total is ${total:,.2f}. "
            "Fix the hours or rate in the source PDF, or create this invoice by hand."
        )

    data = {
        "customer_id": customer_id,
        "date": date_iso,
        "due_date": date_iso,
        "invoice_number": inv_number,
        "reference_number": f"Statement #{inv_number.split('-')[-1]}",
        "line_items": [{
            "name": "Engineering Services",
            "description": f"{format_hours(hours)} × ${rate}/hr — {period}",
            "rate": rate,
            "quantity": hours,
        }]
    }
    resp = api("POST", "/invoices", token, org_id, data, "&ignore_auto_number_generation=true")
    if resp.get("code", 0) != 0:
        raise InvoiceError(f"invoice creation failed: {resp.get('message', resp)}")
    return resp["invoice"]["invoice_id"]


def mark_sent(token, org_id, invoice_id):
    resp = api("POST", f"/invoices/{invoice_id}/status/sent", token, org_id)
    if resp.get("code", 0) != 0:
        raise InvoiceError(f"mark-sent failed: {resp.get('message', resp)}")


def record_payment(token, org_id, customer_id, bank_account_id, invoice_id, amount, date_iso):
    data = {
        "customer_id": customer_id,
        "payment_mode": "Bank Transfer",
        "amount": amount,
        "date": date_iso,
        "account_id": bank_account_id,
        "invoices": [{"invoice_id": invoice_id, "amount_applied": amount}],
    }
    resp = api("POST", "/customerpayments", token, org_id, data)
    if resp.get("code", 0) != 0:
        raise InvoiceError(f"payment recording failed: {resp.get('message', resp)}")


def process_pdf(pdf_path, csv_path, cfg, token, dry_run, deposit_dates=None):
    """
    Run one PDF through the pipeline. Returns a status for the batch summary:
    "created", "skipped" (already in Zoho), or "blocked" (dry run found a
    mismatch). Raises InvoiceError for anything that failed.
    """
    # Parse before announcing, so PDFs that turn out not to be invoices don't
    # each print a header into a directory walk.
    pdf = parse_invoice_pdf(pdf_path)
    print(f"\n{'─' * 60}\n{os.path.basename(pdf_path)}")

    csv_hours = None
    if csv_path:
        csv_hours = parse_csv_hours(csv_path)

    inv_number = f"{cfg['prefix']}-{pdf['stmt_number']}"
    date_iso = parse_date(pdf["date_us"])
    hours = pdf["hours"] if pdf["hours"] is not None else (csv_hours if csv_hours is not None else 0)
    effective_rate = pdf["rate"] if pdf["rate"] is not None else cfg["rate"]
    pdf_total = pdf["total"]

    print(f"  Invoice:  {inv_number}")
    print(f"  Date:     {date_iso}")
    print(f"  Period:   {pdf['period']}")
    if csv_hours is not None:
        print(f"  Hours:    {format_hours(hours)} (PDF) / {csv_hours:.1f}h (CSV — {os.path.basename(csv_path)})")
        csv_total = round(csv_hours * effective_rate, 2)
        if abs(csv_total - pdf_total) > 0.01:
            print(f"  ⚠ Total mismatch: CSV says ${csv_total:,.2f}, PDF says ${pdf_total:,.2f} — using PDF")
    else:
        print(f"  Hours:    {format_hours(hours)} (PDF, no CSV)")
    print(f"  Total:    ${pdf_total:,.2f}")

    # Surface here what create_invoice() would refuse on, so a dry run never
    # reports clean on an invoice the real run will reject.
    computed = round(hours * effective_rate, 2)
    mismatched = abs(computed - pdf_total) > 0.01
    if mismatched:
        print(f"  ✗ {format_hours(hours)} × ${effective_rate}/hr = ${computed:,.2f}, but the PDF total is "
              f"${pdf_total:,.2f} — will refuse to create this invoice.")

    if dry_run:
        print("  [dry-run] no changes made")
        return "blocked" if mismatched else "created"

    existing = find_invoice_by_number(token, cfg["org_id"], inv_number)
    if existing:
        print(f"  ✓ Already exists (ID: {existing['invoice_id']}, status: {existing['status']}) — skipping")
        return "skipped"

    print(f"  Creating {inv_number}...")
    invoice_id = create_invoice(token, cfg["org_id"], cfg["customer_id"], inv_number,
                                date_iso, hours, effective_rate, pdf_total, pdf["period"])
    print("  Marking as sent (no email)...")
    mark_sent(token, cfg["org_id"], invoice_id)
    # Date the payment when the money actually arrived, not when the invoice
    # issued, so it lines up with the bank row Zoho will match it against.
    pay_date = (deposit_dates or {}).get(round(pdf_total, 2))
    if pay_date:
        print(f"  Recording payment dated {pay_date} (matching bank deposit)...")
    else:
        pay_date = date_iso
        print(f"  ⚠ no unmatched ${pdf_total:,.2f} deposit found — "
              f"dating payment {pay_date} (invoice date)")
    record_payment(token, cfg["org_id"], cfg["customer_id"], cfg["bank_account_id"],
                   invoice_id, pdf_total, pay_date)
    print(f"  ✓ {inv_number} created, sent, paid (${pdf_total:,.2f})")
    return "created"


def main():
    p = argparse.ArgumentParser(
        description="Zoho Books invoice pipeline",
        epilog="Pass one or more PDFs, or a directory to process every PDF inside it. "
               "In directory mode, timesheet CSVs found alongside the PDFs are paired "
               "by billing period automatically.",
    )
    p.add_argument("paths", nargs="*", metavar="PDF|DIR",
                   help="Invoice PDFs, or a directory to walk (required unless --list)")
    p.add_argument("--csv", dest="csv_file", default=None, metavar="CSV",
                   help="Timesheet CSV for a single PDF (enables hours/total cross-check)")
    p.add_argument("--list", action="store_true", help="List existing invoices")
    p.add_argument("--dry-run", action="store_true", help="Parse only, don't write to Zoho")
    args = p.parse_args()

    env = load_env()

    if args.list:
        require_env(env, "ZOHO_CLIENT_ID", "ZOHO_CLIENT_SECRET", "ZOHO_REFRESH_TOKEN",
                    "ZOHO_ORG_ID", "ZOHO_CUSTOMER_ID")
        token = get_access_token(env)
        list_invoices(token, env["ZOHO_ORG_ID"], env["ZOHO_CUSTOMER_ID"])
        return

    if not args.paths:
        p.print_help()
        sys.exit(1)

    require_env(env, *ZOHO_KEYS)
    cfg = {
        "org_id": env["ZOHO_ORG_ID"],
        "customer_id": env["ZOHO_CUSTOMER_ID"],
        "bank_account_id": env["ZOHO_BANK_ACCOUNT_ID"],
        "prefix": env.get("ZOHO_INVOICE_PREFIX", "INV"),
        "rate": int(env.get("ZOHO_RATE", 90)),
    }

    # Naming a PDF explicitly means you expect it to be an invoice; walking a
    # directory does not, so unrelated PDFs are only ignored in directory mode.
    walked = any(os.path.isdir(path) for path in args.paths)
    pdfs = collect_pdfs(args.paths)
    if not pdfs:
        print(f"No PDFs found in {', '.join(args.paths)}", file=sys.stderr)
        sys.exit(1)

    if args.csv_file and len(pdfs) > 1:
        print("--csv applies to a single PDF; drop it and let directory mode pair by period.",
              file=sys.stderr)
        sys.exit(1)

    # Explicit --csv wins; otherwise pair by billing period against CSVs sitting
    # beside the PDFs.
    if args.csv_file:
        csv_for = {pdfs[0]: args.csv_file}
    else:
        siblings = {os.path.dirname(f) or "." for f in pdfs}
        candidates = sorted(os.path.join(d, n) for d in siblings
                            for n in os.listdir(d) if n.lower().endswith(".csv"))
        csv_for, ambiguous = pair_csvs(pdfs, candidates)
        if ambiguous:
            print(f"⚠ {len(ambiguous)} PDF(s) share a billing period with another export — "
                  "skipping the CSV cross-check for them (timesheet names carry no year):")
            for path in ambiguous:
                print(f"    {os.path.basename(path)}")

    print(f"Processing {len(pdfs)} invoice(s)"
          f"{' [dry run]' if args.dry_run else ''}, {len(csv_for)} with a CSV cross-check")

    token = None if args.dry_run else get_access_token(env)
    deposit_dates = None if args.dry_run else uncategorized_deposit_dates(
        token, cfg["org_id"], cfg["bank_account_id"])
    if deposit_dates is not None:
        print(f"{len(deposit_dates)} unmatched deposit(s) available to date payments against")

    results = {}
    for pdf_path in pdfs:
        try:
            results[pdf_path] = process_pdf(pdf_path, csv_for.get(pdf_path), cfg,
                                            token, args.dry_run, deposit_dates)
        except NotAnInvoice:
            if not walked:
                print(f"  ✗ {os.path.basename(pdf_path)} is not an invoice PDF", file=sys.stderr)
                results[pdf_path] = "failed"
            else:
                results[pdf_path] = "ignored"
        except InvoiceError as e:
            # One bad export shouldn't strand the rest of the batch — the run is
            # idempotent, so re-running after a fix is safe.
            print(f"  ✗ {e}", file=sys.stderr)
            results[pdf_path] = "failed"

    tally = {k: sum(1 for v in results.values() if v == k)
             for k in ("created", "skipped", "blocked", "failed", "ignored")}
    print(f"\n{'─' * 60}")
    verb = "would create" if args.dry_run else "created"
    print(f"{verb}: {tally['created']}   already in Zoho: {tally['skipped']}   "
          f"blocked: {tally['blocked']}   failed: {tally['failed']}")
    if tally["ignored"]:
        print(f"ignored {tally['ignored']} PDF(s) in the folder that aren't invoices")
    for path, status in results.items():
        if status in ("failed", "blocked"):
            print(f"  {status}: {os.path.basename(path)}")

    if tally["failed"] or tally["blocked"]:
        sys.exit(1)


if __name__ == "__main__":
    main()
